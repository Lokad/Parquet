<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Lokad.Parquet</AssemblyName>
    <RootNamespace>Lokad.Parquet</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageId>Lokad.Parquet</PackageId>
    <Title>Lokad.Parquet</Title>
    <Description>A dependency-free Parquet library for projected reads and flat Snappy-compressed writes on .NET 10 and .NET 11.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0</AssemblyVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See the bundled CHANGELOG.md for release notes.</PackageReleaseNotes>
    <PackageTags>parquet;columnar;analytics;serialization;performance;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/Lokad/Parquet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lokad/Parquet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>..\..\artifacts\nuget\</PackageOutputPath>
    <BeforePack>RequireReleaseConfigurationForPack;PreparePackageReadme;$(BeforePack)</BeforePack>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <Target Name="RequireReleaseConfigurationForPack"
          Condition="'$(Configuration)' != 'Release'">
    <Error Text="Lokad.Parquet packages must be produced from a Release build. Use 'dotnet pack -c Release'." />
  </Target>

  <!-- NuGet displays the README on its package page, outside the repository. -->
  <Target Name="PreparePackageReadme">
    <PropertyGroup>
      <_PackageReadmePath>$(IntermediateOutputPath)package/README.md</_PackageReadmePath>
      <_PackageReadme>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</_PackageReadme>
      <_PackageReadme>$([System.Text.RegularExpressions.Regex]::Replace('$(_PackageReadme)', '\]\((SPEC\.md|BENCHMARKS\.md|LICENSE\.txt)\)', ']($(PackageProjectUrl)/blob/master/$1)'))</_PackageReadme>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PackageReadmePath)" Lines="$(_PackageReadme)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_PackageReadmePath)" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>
