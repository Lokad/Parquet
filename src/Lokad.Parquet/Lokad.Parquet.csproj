<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Lokad.Parquet</AssemblyName>
    <RootNamespace>Lokad.Parquet</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageId>Lokad.Parquet</PackageId>
    <Title>Lokad.Parquet</Title>
    <Description>A high-performance, dependency-free, read-only Parquet library for .NET 10.</Description>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0</AssemblyVersion>
    <FileVersion>0.2.0</FileVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/Lokad/Parquet/blob/v0.2.0/CHANGELOG.md for release notes.</PackageReleaseNotes>
    <PackageTags>parquet;columnar;analytics;serialization;performance;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/Lokad/Parquet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lokad/Parquet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>..\..\artifacts\nuget\</PackageOutputPath>
    <BeforePack>RequireReleaseConfigurationForPack;$(BeforePack)</BeforePack>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <Target Name="RequireReleaseConfigurationForPack"
          Condition="'$(Configuration)' != 'Release'">
    <Error Text="Lokad.Parquet packages must be produced from a Release build. Use 'dotnet pack -c Release'." />
  </Target>

</Project>
